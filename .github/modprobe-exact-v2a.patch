+static const char *current_option_token(char **argv, int optind, const char *optarg)
+{
+	const char *token;
+
+	if (optind <= 0)
+		return NULL;
+	token = argv[optind - 1];
+	if (optarg != NULL && token == optarg && optind > 1)
+		token = argv[optind - 2];
+
+	return token;
+}
