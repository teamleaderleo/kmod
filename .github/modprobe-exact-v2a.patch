+	.env_vars = (const struct keyval[]) {
+		{ "MODPROBE", TOOLS_DIR "/modprobe" },
+		{ }
+	},
+	.output = {
+		.out = ROOTFS "/correct-config-path.txt",
+	},
+	.modules_loaded = "",
