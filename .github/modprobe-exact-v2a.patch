+static int modprobe_options_show_precedence(void)
+{
+	return EXEC_TOOL(modprobe, "--show-alias", "lf_precedence_alias");
+}
+DEFINE_TEST_WITH_FUNC(modprobe_options_exact_precedence, modprobe_options_show_precedence,
+	.description = "check exact recursive options override the legacy mirror",
+	.config = {
+		[TC_UNAME_R] = "4.4.4",
+		[TC_ROOTFS] = ROOTFS,
+	},
+	.env_vars = (const struct keyval[]) {
+		{ "MODPROBE_OPTIONS", "-C /etc/modprobe-config" },
+		{ "KMOD_MODPROBE_OPTIONS", "KMOD1;2:-C,20:/etc/modprobe config," },
+		{ }
+	},
+	.output = {
