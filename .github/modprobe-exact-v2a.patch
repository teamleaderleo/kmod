+#define MODPROBE_OPTIONS_EXACT "KMOD_MODPROBE_OPTIONS"
+#define MODPROBE_OPTIONS_EXACT_PREFIX "KMOD1;"
+#define MODPROBE_OPTIONS_EXACT_PREFIX_LEN 6
+
+static size_t decimal_len(size_t value)
+{
+	size_t len = 1;
+
+	while (value >= 10) {
+		value /= 10;
+		len++;
+	}
+
+	return len;
+}
+
+static int parse_size(const char *start, const char *end, size_t *value)
+{
+	size_t n = 0;
+
+	if (start == end || (end - start > 1 && *start == '0'))
+		return -EINVAL;
+
+	for (const char *p = start; p < end; p++) {
+		unsigned int digit;
+
+		if (*p < '0' || *p > '9')
+			return -EINVAL;
+		digit = (unsigned int)(*p - '0');
+		if (n > (SIZE_MAX - digit) / 10)
+			return -EOVERFLOW;
+		n = n * 10 + digit;
+	}
+
+	*value = n;
+	return 0;
+}
+
+static int env_modprobe_options_exact_set(const struct array *options)
+{
+	char *env, *p;
+	size_t len = MODPROBE_OPTIONS_EXACT_PREFIX_LEN;
+
+	for (size_t i = 0; i < options->count; i++) {
+		const char *arg = options->array[i];
+		size_t arglen = strlen(arg), part;
+
+		if (uaddsz_overflow(decimal_len(arglen), 2, &part) ||
+		    uaddsz_overflow(part, arglen, &part) || uaddsz_overflow(len, part, &len))
+			return -EOVERFLOW;
+	}
+	if (uaddsz_overflow(len, 1, &len))
+		return -EOVERFLOW;
+
+	env = malloc(len);
+	if (env == NULL)
+		return -ENOMEM;
+
+	p = stpcpy(env, MODPROBE_OPTIONS_EXACT_PREFIX);
+	for (size_t i = 0; i < options->count; i++) {
+		const char *arg = options->array[i];
+		size_t arglen = strlen(arg);
+		int n = sprintf(p, "%zu", arglen);
+
+		p += n;
+		*p++ = ':';
+		memcpy(p, arg, arglen);
+		p += arglen;
+		*p++ = ',';
+	}
+	*p = '\0';
+
+	if (setenv(MODPROBE_OPTIONS_EXACT, env, 1) < 0) {
+		int err = -errno;
+
+		free(env);
+		return err;
+	}
+
+	free(env);
+	return 0;
+}
+
+static char **prepend_options_from_exact_env(int *p_argc, char **orig_argv,
+					     int *p_env_argc, char **p_env_start,
+					     char **p_env_end)
+{
+	const char *env = getenv(MODPROBE_OPTIONS_EXACT);
+	const char *p, *limit;
+	char **new_argv, *str;
+	int argc = *p_argc, i;
+	size_t env_argc = 0, string_bytes = 0, pointer_count, pointer_bytes, alloc_size;
+
+	if (env == NULL)
+		return NULL;
+	if (strncmp(env, MODPROBE_OPTIONS_EXACT_PREFIX, MODPROBE_OPTIONS_EXACT_PREFIX_LEN) != 0) {
+		ERR("could not parse $%s: unsupported version\n", MODPROBE_OPTIONS_EXACT);
+		return NULL;
+	}
+
+	p = env + MODPROBE_OPTIONS_EXACT_PREFIX_LEN;
+	limit = env + strlen(env);
+	while (p < limit) {
+		const char *colon = memchr(p, ':', (size_t)(limit - p));
+		size_t arglen, bytes;
+		int err;
+
+		if (colon == NULL)
+			goto invalid;
+		err = parse_size(p, colon, &arglen);
+		if (err < 0)
+			goto invalid;
+		p = colon + 1;
+		if (arglen >= (size_t)(limit - p) || p[arglen] != ',')
+			goto invalid;
+		if (uaddsz_overflow(arglen, 1, &bytes) ||
+		    uaddsz_overflow(string_bytes, bytes, &string_bytes) ||
+		    env_argc == SIZE_MAX)
+			goto overflow;
+		env_argc++;
+		p += arglen + 1;
+	}
+
+	if (env_argc == 0) {
+		*p_env_argc = 0;
+		*p_env_start = NULL;
+		*p_env_end = NULL;
+		return orig_argv;
+	}
+
+	if (env_argc > INT_MAX || uaddsz_overflow((size_t)argc, env_argc, &pointer_count) ||
+	    uaddsz_overflow(pointer_count, 1, &pointer_count) ||
+	    umulsz_overflow(pointer_count, sizeof(char *), &pointer_bytes) ||
+	    uaddsz_overflow(pointer_bytes, string_bytes, &alloc_size))
+		goto overflow;
+
+	new_argv = malloc(alloc_size);
+	if (new_argv == NULL)
+		return NULL;
+
+	new_argv[0] = orig_argv[0];
+	str = (char *)new_argv + pointer_bytes;
+	*p_env_start = str;
+	p = env + MODPROBE_OPTIONS_EXACT_PREFIX_LEN;
+	for (i = 1; p < limit; i++) {
+		const char *colon = strchr(p, ':');
+		size_t arglen;
+
+		if (parse_size(p, colon, &arglen) < 0) {
+			free(new_argv);
+			goto invalid;
+		}
+		p = colon + 1;
+		new_argv[i] = str;
+		memcpy(str, p, arglen);
+		str[arglen] = '\0';
+		str += arglen + 1;
+		p += arglen + 1;
+	}
+	*p_env_end = str;
+
+	memcpy(new_argv + i, orig_argv + 1, sizeof(char *) * (argc - 1));
+	new_argv[i + argc - 1] = NULL;
+	*p_env_argc = i - 1;
+	*p_argc = i + argc - 1;
+
+	return new_argv;
+
+invalid:
+	ERR("could not parse $%s: malformed record\n", MODPROBE_OPTIONS_EXACT);
+	return NULL;
+overflow:
+	ERR("could not parse $%s: value too large\n", MODPROBE_OPTIONS_EXACT);
+	return NULL;
+}
