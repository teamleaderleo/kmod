+static bool option_pointer_is_inherited(const char *p, const char *env_start,
+					const char *env_end)
+{
+	uintptr_t value, start, end;
+
+	if (p == NULL || env_start == NULL)
+		return false;
+	value = (uintptr_t)p;
+	start = (uintptr_t)env_start;
+	end = (uintptr_t)env_end;
+	return value >= start && value < end;
+}
